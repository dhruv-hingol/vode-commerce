# WhatsApp business number: include the country code, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public brand configuration. Set the production origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://vode-style.vercel.app
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional email address for early access requests. Blank = explicit coming-soon form.
# This uses the visitor's email app; it does not pretend to subscribe them to a service.
NEXT_PUBLIC_NEWSLETTER_EMAIL=


# Google Search Console HTML tag content value (not the whole meta tag).
GOOGLE_SITE_VERIFICATION=
